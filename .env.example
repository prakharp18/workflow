# Database URL (Local SQLite File)
DATABASE_URL=file:local.db

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# n8n Webhook URL for Alerts (Optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-alert

# Direct Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Path to Resume PDF or Text file
RESUME_PATH=resume.txt

# Firecrawl API Key for high-accuracy job scraping & site mapping (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY

# Cron schedule for background sync (e.g. every 2 hours)
CRON_SCHEDULE="0 */2 * * *"
